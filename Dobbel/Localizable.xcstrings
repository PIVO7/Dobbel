    },
    "Kiezen hoeft niet — het volgende vakje staat al klaar. Gooi zo goed mogelijk voor precies dát vakje!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No choosing needed — the next box is already waiting. Roll your best for exactly that box!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin de choisir : la case suivante t'attend déjà. Lance au mieux pour cette case-là !"
          }
        }
      }
    },
