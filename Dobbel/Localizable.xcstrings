    "Gemaakt voor gezinnen, niet voor advertenties: niets dat meekijkt en geen abonnement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made for families, not for ads: nothing watching along, no subscription."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu pour les familles, pas pour la publicité : rien qui vous observe, aucun abonnement."
          }
        }
      }
    },
    "Het blad van boven naar onder, zonder kiezen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
