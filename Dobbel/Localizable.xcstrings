            "state" : "translated",
            "value" : "DANS L'ORDRE"
          }
        }
      }
    },
    "In deze spelvorm vul je het blad van boven naar onder: eerst de enen, dan de tweeën… tot en met kans." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this mode you fill the sheet from top to bottom: ones first, then twos… all the way to chance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans cette variante, tu remplis la feuille de haut en bas : d'abord les uns, puis les deux… jusqu'à la chance."
          }
        }
      }
    },
    "In volgorde" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
